{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/admin-users.mjs": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/.netlify/functions/admin-users",
      "destination": "/api/admin-users"
    }
  ]
}
